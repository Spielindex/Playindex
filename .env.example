# Alle Werte werden zur LAUFZEIT gelesen ($env/dynamic/*), nicht zur Buildzeit.
# Auf Cloudflare gehören sie deshalb unter
#   Workers & Pages -> Projekt -> Settings -> Variables and Secrets
# und NICHT unter "Build variables". Secrets bitte als Typ "Secret" anlegen,
# dann landen sie weder im Build-Log noch im Bundle.
#
# --- Identity-Projekt (Supabase) -------------------------------------------
# Das Projekt, in dem Playindex UND das zentrale auth.users liegen.
# Aktuell: das groessere der beiden bestehenden Projekte (siehe docs/03).
PUBLIC_SUPABASE_URL="https://<project-ref>.supabase.co"
PUBLIC_SUPABASE_ANON_KEY="<anon-key>"

# Nur serverseitig. Niemals mit PUBLIC_ praefixen, niemals importieren
# ausserhalb von src/lib/server/**.
SUPABASE_SERVICE_ROLE_KEY="<service-role-key>"

# --- Playindex --------------------------------------------------------------
PUBLIC_SITE_URL="https://playindex.de"
PUBLIC_DEFAULT_CLUB="sportcenter-hahn"

# --- SSO-Partner ------------------------------------------------------------
# Ein eigenes Secret je Partnerdomain. Erzeugen mit:
#   openssl rand -base64 48
# Ein kompromittierter Partner reisst damit nicht das ganze System mit.
SSO_PARTNER_SECRETS='{"padelindex":"<secret>","tennisindex":"<secret>"}'

# Wohin darf ein Handoff weiterleiten? Nur relative Pfade sind erlaubt,
# diese Liste begrenzt zusaetzlich die Praefixe.
SSO_ALLOWED_REDIRECT_PREFIXES="/buchen,/match,/meine-buchungen,/profil"
